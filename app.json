{
  "expo": {
    "name": "翱翔课表",
    "slug": "soaring-schedule",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon/android/play_store_512.png",
    "scheme": "soaringschedule",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.nwpu.soaringschedule",
      "permissions": [
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/android/res/mipmap-xxxhdpi/ic_launcher_foreground.png",
        "backgroundColor": "#607d8b",
        "monochromeImage": "./assets/icon/android/res/mipmap-xxxhdpi/ic_launcher_monochrome.png"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/icon/web/favicon.ico"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#607d8b",
          "image": "./assets/icon/android/play_store_512.png",
          "imageWidth": 120
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      "./plugins/withHonorWidget.js",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "CourseWidget",
              "label": "翱翔课表（显示今天所有课程）",
              "description": "显示今明两天全部课程，可上下滚动查看",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "maxResizeWidth": "250dp",
              "maxResizeHeight": "180dp",
              "resizeMode": "none",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "SmallCourseWidget",
              "label": "翱翔课表（显示后续课程）",
              "description": "显示当天尚未开始的后续课程",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "maxResizeWidth": "180dp",
              "maxResizeHeight": "110dp",
              "resizeMode": "none",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-sharing",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "fcb2c727-044c-4160-8c4e-dda34edf9a8e"
      },
      "router": {}
    },
    "ios": {
      "bundleIdentifier": "com.nwpu.soaringschedule"
    }
  }
}
